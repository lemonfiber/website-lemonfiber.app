---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { copy as t } from "../i18n";

interface Props {
  title?: string;
  description?: string;
  stars?: number;
  active?: string;
}

const { title, description, stars, active } = Astro.props;

const metaDescription = description ?? t.meta.description;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} — ${t.meta.tagline}`;

const origin = Astro.site ?? new URL("https://lemonfiber.app");
const canonical = new URL(Astro.url.pathname, origin).href;

const ogImage = new URL(site.ogImage, origin).href;

// Sitewide identity. Page-specific types (the application itself, the FAQ)
// are declared by the pages that own them, so this graph stays the one thing
// that is true on every page.
const identity = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${origin.origin}/#org`,
      name: site.name,
      url: origin.origin,
      logo: new URL("/brand/logo.svg", origin).href,
      sameAs: [site.githubOrg, site.by.url],
    },
    {
      "@type": "WebSite",
      "@id": `${origin.origin}/#site`,
      name: site.name,
      url: origin.origin,
      inLanguage: "en-GB",
      publisher: { "@id": `${origin.origin}/#org` },
    },
  ],
};
---

<!doctype html>
<html lang={t.meta.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta name="theme-color" content="#17160F" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#FBF7EA" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="light dark" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.tagline} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="generator" content={Astro.generator} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(identity)} />

    {/* Apply the saved theme before paint to avoid a flash. */}
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem("lf-theme");
          if (t === "ink" || t === "paper") {
            document.documentElement.setAttribute("data-theme", t);
          }
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <Nav stars={stars} active={active} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
