---
import Base from "../layouts/Base.astro";
import ProgressBar from "../components/ProgressBar.astro";
import StatusPill from "../components/StatusPill.astro";
import { getSiteData } from "../lib/github";
import { specVersionTrain } from "../lib/spec";
import { site } from "../data/site";
import { statusGlyph } from "../lib/format";

const data = await getSiteData();
const train = await specVersionTrain();

// The train, split into its two epochs — each a major-version arc with its own
// progress. "Built" is implementation (the same signal as the milestone bars,
// scoped to the epoch); "Shipped" is release progress. A version counts fully
// once released, and partly on the way there — staged means its goals are locked,
// in_progress means someone is building it, releasable means it is waiting on a
// tag. Weighting them apart is what lets the bar move while a version is being
// worked on rather than jumping only when one ships.
const RELEASE_WEIGHT: Record<string, number> = {
  released: 1,
  releasable: 0.9,
  in_progress: 0.5,
  staged: 0.25,
};
const releaseWeight = (status: string) => RELEASE_WEIGHT[status] ?? 0;

const epochs = [
  { id: "v1", label: "v1 — the product", areas: "areas A–G", major: "1.0.0" },
  { id: "v2", label: "v2 — the ecosystem", areas: "areas H–K, plus F3", major: "2.0.0" },
]
  .map((epoch) => {
    const versions = train.filter((v) => v.epoch === epoch.id);
    const built = data.progress.byEpoch[epoch.id] ?? { pct: 0, done: 0, total: 0 };
    const shipped = versions.reduce((n, v) => n + releaseWeight(v.status), 0);
    return {
      ...epoch,
      versions,
      built,
      released: versions.filter((v) => v.status === "released").length,
      releasePct: versions.length ? Math.round((shipped / versions.length) * 100) : 0,
    };
  })
  .filter((epoch) => epoch.versions.length > 0);
---

<Base
  active="roadmap"
  stars={data.stars}
  title="Roadmap"
  description="Sequenced milestones, live from the spec and implementation status — no hand-editing.">
  <section class="section head">
    <div class="container">
      <p class="eyebrow">The roadmap</p>
      <h1 class="head__h">Build the thing being wrapped, before the wrapper.</h1>
      <p class="lead head__lead">
        Every milestone is sequenced to keep a working artifact at each step.
        Status here is derived from{" "}
        <a href={`${site.githubOrg}/lemonfiber/blob/main/IMPLEMENTATION-STATUS.md`} target="_blank" rel="noopener">IMPLEMENTATION-STATUS.md</a>{" "}
        — when the code moves, this page moves.
      </p>
      <div class="head__bar card">
        <div class="head__bar-top">
          <span class="head__bar-label">Overall</span>
          <span class="head__bar-n">
            {data.progress.doneMilestones}/{data.progress.totalMilestones} milestones ·
            {data.progress.doneDeliverables}/{data.progress.totalDeliverables} deliverables
          </span>
        </div>
        <ProgressBar pct={data.progress.pct} status="partial" />
      </div>
    </div>
  </section>

  {
    epochs.length > 0 && (
      <section class="section train-sec">
        <div class="container">
          <h2 class="train__h">The version train</h2>
          <p class="train__lead">
            Every release, sourced from the spec's{" "}
            <a href={`${site.docsUrl}/spec/70-operations/versions/`}>version manifests</a> and{" "}
            <a href={`${site.docsUrl}/spec/10-functional/features/`}>feature board</a>. Two epochs, each a
            major-version arc — how much is built, and how much has shipped. Expand a version for
            the features it delivers.
          </p>
          {epochs.map((epoch) => (
            <div class="epoch">
              <header class="epoch__head">
                <div class="epoch__title">
                  <span class="epoch__id">{epoch.id}</span>
                  <h3 class="epoch__name">{epoch.label}</h3>
                  <span class="epoch__to">
                    to <code>{epoch.major}</code>
                  </span>
                </div>
                <div class="epoch__bars">
                  <div class="epoch__bar">
                    <div class="epoch__bar-top">
                      <span class="epoch__bar-label">Built</span>
                      <span class="epoch__bar-n">
                        {epoch.built.total > 0
                          ? `${epoch.built.done}/${epoch.built.total} deliverables`
                          : "not started"}
                      </span>
                    </div>
                    <ProgressBar pct={epoch.built.pct} status="partial" size="sm" />
                  </div>
                  <div class="epoch__bar">
                    <div class="epoch__bar-top">
                      <span class="epoch__bar-label">Shipped</span>
                      <span class="epoch__bar-n">
                        {epoch.released}/{epoch.versions.length} releases
                      </span>
                    </div>
                    <ProgressBar pct={epoch.releasePct} status="partial" size="sm" />
                  </div>
                </div>
              </header>
              <div class="train">
                {epoch.versions.map((v) => (
                  <details class="ver" open={v.status !== "planned"}>
                    <summary class="ver__sum">
                      <code class="ver__num">{v.version}</code>
                      {v.closesEpoch && <span class="ver__closes">epoch complete</span>}
                      <span class:list={["ver__pill", `is-${v.status}`]}>
                        {v.status === "in_progress" ? "in progress" : v.status}
                      </span>
                      <span class="ver__count">{v.features.length} features</span>
                    </summary>
                    <ul class="ver__feats">
                      {v.features.map((f) => {
                        const built = data.features.get(f.id);
                        const state = built?.status ?? "todo";
                        return (
                          <li>
                            <a href={`/roadmap/${f.id.toLowerCase()}`}>
                              <span class:list={["feat__mark", `is-${state}`]} aria-hidden="true">
                                {statusGlyph(state)}
                              </span>
                              <code class="ver__fid">{f.id}</code>
                              <span>{f.title}</span>
                              {built && (
                                <span class="feat__count">
                                  {built.done}/{built.total}
                                </span>
                              )}
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </details>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <section class="section timeline-sec">
    <div class="container">
      <h2 class="tl__sech">Milestones</h2>
      <ol class="tl">
        {
          data.milestones.map((m) => (
            <li class:list={["tl__item", `is-${m.status}`]} id={m.id}>
              <div class="tl__rail">
                <span class="tl__node" aria-hidden="true">{statusGlyph(m.status)}</span>
              </div>
              <article class="tl__card card">
                <header class="tl__head">
                  <div class="tl__title">
                    <span class="tl__id">{m.id}</span>
                    <h2 class="tl__name">{m.title}</h2>
                  </div>
                  <StatusPill status={m.status} />
                </header>
                <p class="tl__blurb">{m.blurb}</p>
                <div class="tl__progress">
                  <ProgressBar pct={m.pct} status={m.status} size="sm" />
                  <span class="tl__repo">
                    {m.repo && <a href={`${site.githubOrg}/${m.repo}`} target="_blank" rel="noopener">{m.repo}</a>}
                  </span>
                </div>
                <ul class="tl__dels">
                  {m.deliverables.map((d) => (
                    <li class:list={["del", `del--${d.status}`]}>
                      <span class="del__glyph" aria-hidden="true">{statusGlyph(d.status)}</span>
                      <span class="del__title">{d.title}</span>
                      {d.spec && <span class="del__spec mono">{d.spec}</span>}
                    </li>
                  ))}
                </ul>
              </article>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container foot-note card">
      <p>
        Want the full argument behind each decision?{" "}
        <a href={site.roadmapUrl} target="_blank" rel="noopener">The canonical roadmap</a>{" "}
        and the <a href={site.specUrl} target="_blank" rel="noopener">795-requirement spec</a>{" "}
        spell out the <em>why</em> for every one.
      </p>
    </div>
  </section>
</Base>

<style>
  .head {
    padding-bottom: var(--space-6);
  }
  .head__h {
    font-size: var(--size-display-xl);
    margin-top: var(--space-3);
    max-width: 20ch;
  }
  .head__lead {
    margin-top: var(--space-5);
    max-width: 62ch;
  }
  .head__lead a {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .head__bar {
    margin-top: var(--space-6);
    padding: var(--space-5);
  }
  .head__bar-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }
  .head__bar-label {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: var(--tracking-tight);
  }
  .head__bar-n {
    font-size: var(--size-caption);
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .train-sec {
    padding-bottom: var(--space-6);
  }
  .train__h,
  .tl__sech {
    font-size: var(--size-display-m);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-3);
  }
  .train__lead {
    color: var(--text-muted);
    max-width: 64ch;
    margin-bottom: var(--space-5);
  }
  .train__lead a {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .epoch {
    margin-bottom: var(--space-6);
  }
  .epoch__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    flex-wrap: wrap;
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--border);
  }
  .epoch__title {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .epoch__id {
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--accent-strong);
    background: var(--wip-bg);
    padding: 0.2em 0.6em;
    border-radius: 999px;
  }
  .epoch__name {
    font-size: var(--size-display-s, 1.35rem);
    letter-spacing: var(--tracking-tight);
  }
  .epoch__to {
    font-size: 0.82rem;
    color: var(--text-faint);
  }
  .epoch__to code {
    font-family: var(--font-mono);
    color: var(--accent-strong);
  }
  .epoch__bars {
    display: grid;
    grid-template-columns: repeat(2, minmax(9rem, 14rem));
    gap: var(--space-4);
    flex: 1 1 20rem;
  }
  .epoch__bar-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: 0.35rem;
  }
  .epoch__bar-label {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.8rem;
    letter-spacing: var(--tracking-tight);
  }
  .epoch__bar-n {
    font-size: 0.68rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .train {
    display: grid;
    gap: var(--space-3);
  }
  .ver {
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .ver__sum {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    cursor: pointer;
    flex-wrap: wrap;
    list-style: none;
  }
  .ver__sum::-webkit-details-marker {
    display: none;
  }
  .ver__num {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1rem;
    color: var(--accent-strong);
  }
  .ver__closes {
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--ok);
    background: var(--ok-bg);
    padding: 0.15em 0.6em;
    border-radius: 999px;
    font-weight: 700;
  }
  .ver__pill {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15em 0.6em;
    border-radius: 999px;
    font-weight: 600;
  }
  .ver__pill.is-released {
    color: var(--ok);
    background: var(--ok-bg);
  }
  .ver__pill.is-staged {
    color: var(--accent-strong);
    background: var(--wip-bg);
  }
  /* The one being built right now — the loudest thing on the page after what has
     already shipped, because it is the question most people arrive with. */
  .ver__pill.is-in_progress {
    color: var(--accent-strong);
    background: var(--wip-bg);
    border: 1px solid currentColor;
  }
  .ver__pill.is-releasable {
    color: var(--ok);
    background: var(--ok-bg);
    border: 1px dashed currentColor;
  }
  .ver__pill.is-planned {
    color: var(--text-muted);
    background: var(--bg-tint);
  }
  .ver__count {
    margin-left: auto;
    font-size: 0.82rem;
    color: var(--text-faint);
    font-family: var(--font-mono);
  }
  /* Built, being built, not started — the same three the milestone list uses, so
     one glance reads the same way in both places. */
  .feat__mark.is-done {
    color: var(--ok);
  }
  .feat__mark.is-partial {
    color: var(--accent-strong);
  }
  .feat__mark.is-todo {
    color: var(--text-faint);
  }
  .feat__count {
    margin-left: auto;
    font-size: 0.78rem;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
  .ver__feats {
    list-style: none;
    margin: 0;
    padding: var(--space-3) var(--space-5) var(--space-4);
    display: grid;
    gap: 0.2rem;
    border-top: 1px dashed var(--border);
  }
  .ver__feats a {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    padding: 0.25rem 0.35rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: inherit;
    font-size: 0.9rem;
  }
  .ver__feats a:hover {
    background: var(--surface-2);
  }
  .ver__fid {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-strong);
  }

  .timeline-sec {
    padding-top: 0;
  }
  .tl {
    list-style: none;
    display: grid;
    gap: var(--space-5);
  }
  .tl__item {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: var(--space-3);
    scroll-margin-top: calc(var(--nav-h) + var(--space-5));
  }
  .tl__rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: var(--space-5);
  }
  .tl__node {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-size: 0.9rem;
    border: 2px solid var(--border);
    background: var(--surface);
    z-index: 1;
  }
  .is-done .tl__node {
    color: var(--ok);
    border-color: var(--ok);
    background: var(--ok-bg);
  }
  .is-partial .tl__node {
    color: var(--accent-strong);
    border-color: var(--accent);
    background: var(--wip-bg);
  }
  .tl__rail::after {
    content: "";
    flex: 1;
    width: 2px;
    background: var(--border);
    margin-top: 4px;
  }
  .tl__item:last-child .tl__rail::after {
    display: none;
  }

  .tl__card {
    padding: var(--space-5);
  }
  .tl__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .tl__title {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }
  .tl__id {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--accent-strong);
    background: var(--wip-bg);
    padding: 0.15em 0.55em;
    border-radius: var(--radius-sm);
  }
  .tl__name {
    font-size: var(--size-display-m);
    letter-spacing: var(--tracking-tight);
  }
  .tl__blurb {
    margin-top: var(--space-3);
    color: var(--text-muted);
  }
  .tl__progress {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }
  .tl__repo a {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-faint);
    border: 1px solid var(--border-soft);
    padding: 0.15em 0.5em;
    border-radius: var(--radius-sm);
  }
  .tl__repo a:hover {
    color: var(--accent-strong);
    border-color: var(--accent);
  }
  .tl__dels {
    list-style: none;
    display: grid;
    gap: 0.1rem;
    margin-top: var(--space-4);
    border-top: 1px dashed var(--border);
    padding-top: var(--space-4);
  }
  .del {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.6rem;
    padding: 0.3rem 0.35rem;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
  }
  .del:hover {
    background: var(--surface-2);
  }
  .del__glyph {
    font-size: 0.72rem;
  }
  .del--done .del__glyph {
    color: var(--ok);
  }
  .del--partial .del__glyph {
    color: var(--accent-strong);
  }
  .del--todo .del__glyph {
    color: var(--todo);
  }
  .del--todo .del__title {
    color: var(--text-muted);
  }
  .del__spec {
    font-size: 0.7rem;
    color: var(--text-faint);
    border: 1px solid var(--border-soft);
    padding: 0.05em 0.4em;
    border-radius: var(--radius-sm);
  }
  .foot-note {
    padding: var(--space-5);
    text-align: center;
    color: var(--text-muted);
    background: var(--bg-tint);
  }
  .foot-note a {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  @media (max-width: 640px) {
    .tl__item {
      grid-template-columns: 26px 1fr;
    }
    .tl__node {
      width: 26px;
      height: 26px;
      font-size: 0.7rem;
    }
    .del {
      grid-template-columns: auto 1fr;
    }
    .del__spec {
      display: none;
    }
  }
</style>
