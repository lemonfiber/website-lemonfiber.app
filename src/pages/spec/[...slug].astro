---
// A page of the specification, rendered at the commit of `spec` the board
// snapshot read, with the revision it came from and where to edit it.
import Base from "../../layouts/Base.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { specSlug } from "../../lib/spec-pages";
import { commitUrl } from "../../lib/roadmap";
import { specCopy as t } from "../../i18n";

export async function getStaticPaths() {
  const pages = await getCollection("spec");
  return pages.map((page) => ({
    params: { slug: specSlug(page.id) },
    props: { page },
  }));
}

const { page } = Astro.props as { page: CollectionEntry<"spec"> };
const { Content } = await render(page);
const { mirror } = page.data;
---

<Base active="spec" title={page.data.title} description={t.description}>
  <section class="section head">
    <div class="container">
      <a class="back" href="/spec/">
        {t.back}
      </a>
      <h1 class="head__h">{page.data.title}</h1>
      <p class="src">
        {t.renderedAt}
        <a class="mono" href={commitUrl(`spec@${mirror.revision}`)}>
          {mirror.revision.slice(0, 7)}
        </a>
        {mirror.date && ` (${mirror.date.slice(0, 10)})`}
        {" · "}
        <a href={mirror.source}>{t.source}</a>
        {" · "}
        <a href={page.data.editUrl}>{t.edit}</a>
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container prose spec">
      <Content />
    </div>
  </section>
</Base>

<style>
  .back,
  .src,
  .src a {
    color: var(--text-muted);
  }
  .back,
  .src {
    font-size: var(--size-caption);
  }
  .head__h {
    font-size: var(--size-display-l);
    margin: var(--space-3) 0 var(--space-4);
  }
  .spec :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    margin: var(--space-4) 0;
  }
  .spec :global(th),
  .spec :global(td) {
    text-align: left;
    vertical-align: top;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--border-soft);
  }
  .spec :global(tr[id]) {
    scroll-margin-top: calc(var(--nav-h) + var(--space-4));
  }
  .spec :global(tr:target) {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
</style>
