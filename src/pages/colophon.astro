---
import Base from "../layouts/Base.astro";
import Colophon from "../components/Colophon.astro";
import { copy as t } from "../i18n";
---

<Base active="colophon" title={t.colophon.title} description={t.colophon.lead}>
  <header class="section doc__head">
    <div class="container">
      <p class="eyebrow">{t.colophon.eyebrow}</p>
      <h1 class="doc__h">{t.colophon.title}</h1>
      <p class="lead doc__lead">{t.colophon.lead}</p>
    </div>
  </header>
  <div class="container doc__body">
    <Colophon />
  </div>
</Base>

<style>
  .doc__head {
    padding-bottom: var(--space-4);
    background: radial-gradient(
      110% 60% at 20% -20%,
      color-mix(in srgb, var(--accent) 10%, transparent),
      transparent 60%
    );
  }
  .doc__h {
    font-size: var(--size-display-xl);
    margin-top: var(--space-3);
    max-width: 22ch;
  }
  .doc__lead {
    margin-top: var(--space-4);
    max-width: 62ch;
  }
  .doc__body {
    padding-bottom: var(--space-9);
  }
</style>
