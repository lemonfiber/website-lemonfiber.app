---
import Base from "../layouts/Base.astro";
import DocPage from "../components/DocPage.astro";
import ReleaseAssets from "../components/ReleaseAssets.astro";
import { pages } from "../i18n";

const doc = pages.install;
---

<Base active="install" title={doc.title} description={doc.lead}>
  <DocPage doc={doc}>
    <ReleaseAssets />
  </DocPage>
</Base>
