---
import { site, siblings } from "../data/site";
import { copyFor, localePath, pathFor, DEFAULT_LOCALE, type Locale } from "../i18n";

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = copyFor(locale);

const cols = [
  {
    title: t.footer.project,
    links: [
      { label: t.nav.home, href: pathFor(locale, "/") },
      { label: t.nav.roadmap, href: pathFor(locale, "/roadmap") },
      { label: t.nav.install, href: pathFor(locale, "/install") },
      { label: t.nav.changelog, href: pathFor(locale, "/changelog") },
      { label: t.nav.transparency, href: pathFor(locale, "/transparency") },
      { label: t.nav.contribute, href: pathFor(locale, "/contribute") },
      { label: t.nav.faq, href: pathFor(locale, "/faq") },
      { label: t.nav.colophon, href: pathFor(locale, "/colophon") },
    ],
  },
  {
    title: t.footer.source,
    links: [
      { label: t.cta.spec, href: site.specUrl },
      { label: "lemonfiber (binary)", href: "https://github.com/lemonfiber/lemonfiber" },
      { label: "lemonfiber-media-stack", href: "https://github.com/lemonfiber/lemonfiber-media-stack" },
      { label: t.footer.org, href: site.githubOrg },
    ],
  },
  {
    title: "Specification",
    links: [
      { label: "Browse the spec", href: pathFor(locale, "/spec") },
      { label: "RFCs & Drafts", href: pathFor(locale, "/rfc") },
      { label: "Features", href: pathFor(locale, "/spec/10-functional/features/README") },
      { label: "User journeys", href: pathFor(locale, "/spec/10-functional/journeys/README") },
      { label: "Architecture", href: pathFor(locale, "/spec/20-architecture/README") },
    ],
  },
  {
    title: t.footer.community,
    links: [
      { label: "Discord", href: site.discord },
      { label: t.cta.goodFirstIssues, href: "https://github.com/lemonfiber/lemonfiber/issues?q=is%3Aissue+is%3Aopen+label%3A%22good+first+issue%22" },
      { label: "Code of Conduct", href: "https://github.com/lemonfiber/.github/blob/main/CODE_OF_CONDUCT.md" },
      { label: "Security", href: "https://github.com/lemonfiber/.github/blob/main/SECURITY.md" },
    ],
  },
];
---

<footer class="ft">
  <div class="container ft__inner">
    <div class="ft__brand">
      <a href={localePath(locale, "/")} class="ft__logo" aria-label="Lemonfiber home">
        <img src="/brand/mark-small.svg" alt="" width="40" height="40" />
        <span>Lemonfiber</span>
      </a>
      <p class="ft__tag">{t.meta.tagline}.</p>
      <p class="ft__lic">
        <a href={site.licenseUrl} target="_blank" rel="noopener">{t.footer.license}</a> —
        {t.footer.sourceAvailable}. © {new Date().getFullYear()} {site.by.name}.
      </p>
    </div>

    <nav class="ft__cols" aria-label="Footer">
      {
        cols.map((col) => (
          <div class="ft__col">
            <h5>{col.title}</h5>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={l.href} target={l.href.startsWith("http") ? "_blank" : undefined} rel="noopener">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="ft__col">
        <h5>{t.footer.alsoFrom}</h5>
        <ul>
          {
            siblings.map((s) => (
              <li>
                <a class="sib" href={s.url} target="_blank" rel="noopener">
                  <b>{s.label}</b>
                  <span>{t.footer[s.key as "beatrax" | "happklaar"]}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>
  </div>

  <div class="container ft__base">
    <span class="ft__built">{t.footer.builtInOpen}</span>
    <a class="ft__nw" href={site.by.url} target="_blank" rel="noopener" aria-label="NightWorks.io">
      <img class="nw-dark" src="/brand/nightworks-dark.png" alt="NightWorks.io" height="18" />
      <img class="nw-white" src="/brand/nightworks-white.png" alt="NightWorks.io" height="18" />
    </a>
  </div>
</footer>

<style>
  .ft {
    margin-top: var(--space-9);
    border-top: 1px solid var(--border);
    background: var(--bg-tint);
    padding-block: var(--space-8) var(--space-5);
  }
  .ft__inner {
    display: grid;
    /* The link block went from three columns to four, so the brand column
       gives up some width rather than squeezing the labels. */
    grid-template-columns: 1fr 2.4fr;
    gap: var(--space-7);
  }
  .ft__logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.3rem;
    letter-spacing: var(--tracking-display);
  }
  .ft__tag {
    margin-top: var(--space-3);
    color: var(--text-muted);
    max-width: 34ch;
  }
  .ft__lic {
    margin-top: var(--space-4);
    font-size: var(--size-caption);
    color: var(--text-faint);
  }
  .ft__lic a {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .ft__cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
  }
  .ft__col h5 {
    font-family: var(--font-display);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--text-faint);
    margin-bottom: var(--space-3);
  }
  .ft__col ul {
    list-style: none;
    display: grid;
    gap: var(--space-2);
  }
  .ft__col a {
    color: var(--text-muted);
    font-size: 0.92rem;
  }
  .ft__col a:hover {
    color: var(--accent-strong);
  }
  .sib {
    display: flex;
    flex-direction: column;
    line-height: 1.35;
  }
  .sib b {
    font-weight: 700;
  }
  .sib span {
    font-size: 0.74rem;
    color: var(--text-faint);
  }
  .ft__base {
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-soft);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .ft__built {
    font-size: var(--size-caption);
    color: var(--text-faint);
  }
  .nw-white {
    display: none;
  }
  :root[data-theme="ink"] .nw-dark {
    display: none;
  }
  :root[data-theme="ink"] .nw-white {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="paper"]) .nw-dark {
      display: none;
    }
    :root:not([data-theme="paper"]) .nw-white {
      display: block;
    }
  }

  @media (max-width: 760px) {
    .ft__inner {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .ft__cols {
      grid-template-columns: repeat(2, 1fr);
    }
    .ft__base {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: var(--space-3);
    }
  }
</style>
