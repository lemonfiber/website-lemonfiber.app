---
import { site } from "../data/site";
import { compact } from "../lib/format";
import { copy as t } from "../i18n";

interface Props {
  stars?: number;
  active?: string;
}
const { stars, active } = Astro.props;

// Transparency lives in the footer: it is a reference page for someone already
// checking the project's claims, not a step on the way in. Dropping it also
// keeps the row short.
const links = [
  { href: "/", label: t.nav.home, key: "home" },
  { href: "/roadmap", label: t.nav.roadmap, key: "roadmap" },
  { href: "/install", label: t.nav.install, key: "install" },
  { href: "/contribute", label: t.nav.contribute, key: "contribute" },
  { href: "/faq", label: t.nav.faq, key: "faq" },
];
---

<header class="nav">
  <div class="nav__inner container">
    <a class="brand" href="/" aria-label="Lemonfiber home">
      <img src="/brand/mark-small.svg" alt="" width="32" height="32" class="brand__mark" />
      <span class="brand__word">Lemonfiber</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={["nav__link", { "is-active": active === l.key }]}
            aria-current={active === l.key ? "page" : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="nav__actions">
      <a class="nav__icon" href={site.discord} target="_blank" rel="noopener" aria-label="Discord">
        <img src="/brand/discord.svg" alt="" width="20" height="20" />
      </a>
      <a class="nav__star" href={site.githubOrg} target="_blank" rel="noopener" aria-label="Lemonfiber on GitHub">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.49-2.7-1.07-2.7-1.07-.36-.93-.89-1.18-.89-1.18-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.72 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
        </svg>
        {stars ? <span>{compact(stars)}</span> : null}
      </a>
      <button class="nav__theme" id="theme-toggle" type="button" aria-label="Switch colour theme" title="Switch theme">
        <svg class="ico-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5 19 19M19 5l-1.5 1.5M6.5 17.5 5 19" />
        </svg>
        <svg class="ico-moon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg>
      </button>

      <button
        class="navtoggle"
        type="button"
        aria-label={t.nav.menu}
        aria-expanded="false"
        aria-controls="nav-panel"
        data-nav-toggle
      >
        <span class="navtoggle__bar" aria-hidden="true"></span>
        <span class="navtoggle__bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div class="navpanel" id="nav-panel" hidden data-nav-panel>
    <nav class="container navpanel__inner" aria-label={t.nav.menu}>
      {
        links.map((l) => (
          <a
            class:list={["navpanel__link", { "is-active": active === l.key }]}
            href={l.href}
            aria-current={active === l.key ? "page" : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;
    const root = document.documentElement;
    btn.addEventListener("click", () => {
      const prefersDark = matchMedia("(prefers-color-scheme: dark)").matches;
      const current = root.getAttribute("data-theme") || (prefersDark ? "ink" : "paper");
      const next = current === "ink" ? "paper" : "ink";
      root.setAttribute("data-theme", next);
      try {
        localStorage.setItem("lf-theme", next);
      } catch {}
    });
  })();
</script>

<script is:inline>
  (() => {
    const toggle = document.querySelector("[data-nav-toggle]");
    const panel = document.querySelector("[data-nav-panel]");
    if (!toggle || !panel) return;

    const setOpen = (open) => {
      toggle.setAttribute("aria-expanded", String(open));
      panel.hidden = !open;
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });

    // Growing past the breakpoint reveals the desktop nav; leaving the panel
    // open would stack a second copy of the same links underneath it.
    window.matchMedia("(min-width: 901px)").addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  })();
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--border-soft);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    width: 100%;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin-right: auto;
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: var(--tracking-display);
    font-size: 1.25rem;
  }
  .brand__mark {
    transition: transform 0.3s ease;
  }
  .brand:hover .brand__mark {
    transform: rotate(45deg);
  }
  .nav__links {
    display: flex;
    gap: var(--space-2);
  }
  .nav__link {
    padding: 0.45em 0.8em;
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text-muted);
    transition: color 0.14s ease, background-color 0.14s ease;
  }
  .nav__link:hover {
    color: var(--text);
    background: var(--surface-2);
  }
  .nav__link.is-active {
    color: var(--text);
    background: var(--surface-2);
  }
  .nav__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .nav__icon,
  .nav__theme,
  .nav__star {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35em;
    height: 38px;
    min-width: 38px;
    padding-inline: 0.5em;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    transition: border-color 0.14s ease, transform 0.14s ease;
    font-weight: 700;
    font-size: 0.85rem;
  }
  .nav__icon img {
    opacity: 0.8;
  }
  .nav__icon:hover,
  .nav__theme:hover,
  .nav__star:hover {
    border-color: var(--text);
    transform: translateY(-1px);
  }
  .ico-moon {
    display: none;
  }
  :root[data-theme="ink"] .ico-sun {
    display: none;
  }
  :root[data-theme="ink"] .ico-moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="paper"]) .ico-sun {
      display: none;
    }
    :root:not([data-theme="paper"]) .ico-moon {
      display: block;
    }
    :root[data-theme="paper"] .ico-moon {
      display: none;
    }
    :root[data-theme="paper"] .ico-sun {
      display: block;
    }
  }

  /* ── Mobile menu ───────────────────────────────────────────────── */
  .navtoggle {
    display: none;
    height: 38px;
    width: 38px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    padding: 0;
    place-content: center;
    justify-items: center;
    gap: 5px;
    transition: border-color 0.14s ease;
  }
  .navtoggle:hover {
    border-color: var(--text);
  }
  .navtoggle__bar {
    display: block;
    width: 16px;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.18s ease;
  }
  .navtoggle[aria-expanded="true"] .navtoggle__bar:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  .navtoggle[aria-expanded="true"] .navtoggle__bar:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }
  .navpanel {
    border-top: 1px solid var(--border-soft);
    background: var(--bg);
  }
  .navpanel__inner {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-4);
  }
  .navpanel__link {
    padding: var(--space-3) 0;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-soft);
    font-weight: 600;
  }
  .navpanel__link:hover,
  .navpanel__link.is-active {
    color: var(--text);
  }

  /* Measured, not guessed: with five links the whole row needs ~750px plus
     ~120px once the brand word is shown. 900px collapses just below that,
     with headroom for a longer label later. */
  @media (max-width: 900px) {
    .nav__inner {
      gap: var(--space-3);
    }
    .brand__word {
      display: none;
    }
    /* The inline links move into the panel rather than becoming a scroll
       strip — six items no longer fit horizontally on a phone, and a strip
       hides whatever is past its right edge with no affordance saying so. */
    .nav__links {
      display: none;
    }
    .navtoggle {
      display: grid;
    }
    .nav__icon {
      display: none;
    }
  }
  @media (min-width: 901px) {
    .navpanel {
      display: none;
    }
  }
</style>
