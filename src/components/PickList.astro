---
// The goals to pick up of each version taking work, grouped by the
// repositories whose trackers hold them.
import ReqLink from "./ReqLink.astro";
import type { Version } from "../lib/board";
import { byRepo, type Pickable } from "../lib/pick";
import { pickCopy as t, roadmapCopy } from "../i18n";

interface Props {
  versions: { version: Version; goals: Pickable[] }[];
}

const { versions } = Astro.props;
---

{versions.length === 0 && <p>{t.noVersion}</p>}
{versions.map(({ version, goals }) => (
  <section class="ver" aria-labelledby={`v-${version.version}`}>
    <h2 class="sec__h" id={`v-${version.version}`}>
      <a class="mono" href={`/roadmap/${version.version}/`}>
        {version.version}
      </a>
      <span class="ver__count">{t.goals(goals.length)}</span>
    </h2>
    {goals.length === 0 && <p>{t.none}</p>}
    {byRepo(goals).map((group) => (
      <section class="grp">
        <h3 class="grp__h">
          {group.repo ? (
            <a class="mono" href={`/repos/${group.repo}/`}>
              {group.repo}
            </a>
          ) : (
            t.nowhere
          )}
        </h3>
        <ul class="goals">
          {group.goals.map((g) => (
            <li class="goal">
              <ReqLink id={g.id} page={g.page} />
              <span class="goal__verdict">
                {`${roadmapCopy.verdict[g.verdict].glyph} ${roadmapCopy.verdict[g.verdict].word}`}
              </span>
              {g.area && (
                <span class="goal__area">{`${t.label.area} ${g.area}`}</span>
              )}
              {g.text && <p class="goal__text">{g.text}</p>}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </section>
))}

<style>
  .ver {
    margin-bottom: var(--space-7);
  }
  .ver .sec__h {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
  }
  .ver__count,
  .goal__verdict,
  .goal__area {
    font-size: var(--size-caption);
    color: var(--text-muted);
    font-weight: 400;
  }
  .grp__h {
    margin: var(--space-5) 0 var(--space-2);
    font-size: var(--size-body);
  }
  .goals {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }
  .goal {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-soft);
  }
  .goal__text {
    flex-basis: 100%;
    margin: 0;
  }
</style>
