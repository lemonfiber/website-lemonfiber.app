---
// Rendered from the spec's 90-appendix/colophon.md at build time. Nothing is
// duplicated here — if the list is wrong, the spec is wrong, and fixing it
// there fixes it everywhere.
//
// When the spec is unreachable the page falls back to a link rather than a
// stale copy: a credits list that silently goes out of date is worse than one
// that sends you to the source.
import { getColophon } from "../lib/github";
import { site } from "../data/site";
import { copy as t } from "../i18n";

const groups = await getColophon();
// See the note in Faq.astro — same reasoning.
const specUrl = site.specUrl;
---

<div class="col">
  {
    groups.length === 0 ? (
      <p class="col__empty">
        {t.colophon.unavailable}{" "}
        <a href={specUrl} target="_blank" rel="noopener">
          {t.colophon.readInSpec}
        </a>
      </p>
    ) : (
      groups.map((g) => (
        <section class="col__group">
          <h2 class="col__h">{g.heading}</h2>
          <dl class="col__list">
            {g.entries.map((e) => (
              <div class="col__row">
                <dt class="col__name">{e.name}</dt>
                <dd class="col__desc">{e.body}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))
    )
  }

  <p class="col__source">
    <a href={specUrl} target="_blank" rel="noopener">{t.colophon.source} →</a>
  </p>
</div>

<style>
  .col__group {
    margin-top: var(--space-8);
  }
  .col__h {
    font-size: var(--size-display-l);
    letter-spacing: var(--tracking-tight);
  }
  .col__list {
    margin-top: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }
  .col__row {
    display: grid;
    grid-template-columns: minmax(140px, 220px) 1fr;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--border-soft);
  }
  .col__row:last-child {
    border-bottom: none;
  }
  .col__name {
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
  }
  .col__desc {
    color: var(--text-muted);
    font-size: 0.94rem;
  }
  .col__empty {
    margin-top: var(--space-6);
    color: var(--text-muted);
  }
  .col__empty a,
  .col__source a {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .col__source {
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border-soft);
    font-size: 0.9rem;
  }
  @media (max-width: 640px) {
    .col__row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
