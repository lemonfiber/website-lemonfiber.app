---
import { statusGlyph, statusLabel } from "../lib/format";

interface Props {
  status: "done" | "partial" | "todo";
  text?: string;
}
const { status, text } = Astro.props;
---

<span class:list={["pill", `pill--${status}`]}>
  <span class="pill__glyph" aria-hidden="true">{statusGlyph(status)}</span>
  {text ?? statusLabel(status)}
</span>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: var(--size-caption);
    font-weight: 700;
    padding: 0.2em 0.7em;
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    white-space: nowrap;
  }
  .pill__glyph {
    font-size: 0.7em;
  }
  .pill--done {
    color: var(--ok);
    background: var(--ok-bg);
    border-color: color-mix(in srgb, var(--ok) 30%, transparent);
  }
  .pill--partial {
    color: var(--accent-strong);
    background: var(--wip-bg);
    border-color: color-mix(in srgb, var(--wip) 35%, transparent);
  }
  .pill--todo {
    color: var(--text-faint);
    background: var(--todo-bg);
    border-color: var(--border-soft);
  }
</style>
