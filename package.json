{
  "name": "@lemonfiber/website-lemonfiber.app",
  "version": "0.1.0",
  "private": true,
  "description": "The lemonfiber frontpage — a build-in-the-open site driven by the GitHub org.",
  "type": "module",
  "license": "Hippocratic-3.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check --minimumFailingSeverity hint",
    "links": "node scripts/links.mjs",
    "a11y": "node scripts/a11y.mjs",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "sync": "astro sync",
    "og": "node scripts/og.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.2",
    "@astrojs/preact": "6.0.6",
    "@lemonfiber/website-kit": "github:lemonfiber/website-kit#30ab4066abfb83a3ce65ed4f013f3344f977b4dd",
    "astro": "7.3.5",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/hast": "3.0.5",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
