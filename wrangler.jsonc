// The host's configuration for this site: an assets-only Cloudflare Worker that
// serves the build `deploy.yml` makes. Wrangler uploads `dist/` as it stands;
// the response headers come from the `_headers` file the build writes at its
// root, so nothing about how a page is served is set on a dashboard. The site's
// domain is a Custom Domain of the Worker: a deploy creates its DNS record and
// certificate, so no other record may hold the name. It also answers at its
// workers.dev address.
{
  "name": "website-lemonfiber",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "./dist",
    // `/start/` serves `start/index.html`, and `/start` redirects to it.
    "html_handling": "auto-trailing-slash",
    // A path with no page gets the site's 404.html.
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "lemonfiber.app", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false,
}
